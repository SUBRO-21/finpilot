# Copy to packages/db/.env (DATABASE_URL only) and apps/api/.env (everything)
# MongoDB must be a replica set for Prisma (Atlas free tier works)
# Local single-node replica set (see README): mongodb://127.0.0.1:27018/finos?replicaSet=rs0&directConnection=true
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/finos?retryWrites=true&w=majority"
JWT_SECRET="change-me"
# AI: fill in a Groq and/or Gemini key. AI_PROVIDER picks one (groq|gemini); blank = whichever key is set, Groq first.
AI_PROVIDER=""
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# apps/web/.env.local
# NEXT_PUBLIC_API_URL="http://localhost:4000"
